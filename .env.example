# Salin ke .env untuk override lokal. Jangan commit .env.
# Compose sudah mengisi DATABASE_URL; file ini untuk menjalankan `npm run dev` di host.

DATABASE_URL="mysql://coffeeniche_user:coffeeniche_pass@127.0.0.1:3309/coffeeniche_db"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_NAME="CoffeeNiche"
